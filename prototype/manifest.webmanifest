{
  "name": "HabitCrafts Japanese",
  "short_name": "Japanese",
  "description": "Daily review of the Japanese you uploaded. Everything due across every deck, one card at a time.",

  "start_url": "app.html?x=japanese&solo=1#/today",
  "scope": "./",
  "id": "habitcrafts-japanese",

  "display": "standalone",
  "orientation": "portrait",

